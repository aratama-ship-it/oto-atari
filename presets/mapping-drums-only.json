{
  "format": "oto-atari.mapping",
  "version": 1,
  "name": "drums-only",
  "description": "打楽器（キック・スネア・ハイハット）にだけ反応する。他の音には何も出さない。",
  "limits": {
    "maxPerSec": 12
  },
  "palettes": {
    "paper": {
      "surface": "#ece6da",
      "sub": "#141414",
      "bass": "#1f2a5c",
      "lowmid": "#6b3fa0",
      "mid": "#e2452f",
      "high": "#f5b400",
      "air": "#38c6d9",
      "accent": "#ff5fa2"
    }
  },
  "startPalette": "paper",
  "rules": [
    {
      "id": "kick-splat",
      "on": {
        "event": "onset",
        "tags": [
          "kick"
        ],
        "minConfidence": 0.4
      },
      "emit": {
        "intent": "splat",
        "zone": "low",
        "color": "@palette.bass",
        "size": {
          "from": "strength",
          "range": [
            0.5,
            1.0
          ],
          "curve": "pow0.5"
        },
        "weight": 1.0,
        "decaySec": 1.5,
        "spread": 0.25,
        "x": {
          "from": "pan",
          "domain": [
            -1,
            1
          ],
          "range": [
            0.08,
            0.92
          ]
        }
      }
    },
    {
      "id": "kick-pulse",
      "on": {
        "event": "onset",
        "tags": [
          "kick"
        ],
        "minConfidence": 0.4
      },
      "emit": {
        "intent": "pulse",
        "zone": "all",
        "color": "#ffffff",
        "level": 0.35,
        "decaySec": 0.18
      },
      "enabled": false
    },
    {
      "id": "snare-splat",
      "on": {
        "event": "onset",
        "tags": [
          "snare"
        ],
        "minConfidence": 0.4,
        "onBeat": {
          "tolSec": 0.07
        }
      },
      "emit": {
        "intent": "splat",
        "zone": "high",
        "color": "@palette.mid",
        "size": {
          "from": "strength",
          "range": [
            0.3,
            0.7
          ]
        },
        "weight": 0.35,
        "decaySec": 0.9,
        "spread": 0.7,
        "x": {
          "from": "pan",
          "domain": [
            -1,
            1
          ],
          "range": [
            0.08,
            0.92
          ]
        }
      }
    },
    {
      "id": "clap-splat",
      "on": {
        "event": "onset",
        "tags": [
          "clap"
        ],
        "minConfidence": 0.4
      },
      "emit": {
        "intent": "splat",
        "zone": "high",
        "color": "@palette.mid",
        "size": {
          "from": "strength",
          "range": [
            0.3,
            0.7
          ]
        },
        "weight": 0.35,
        "decaySec": 0.9,
        "spread": 0.7,
        "x": {
          "from": "pan",
          "domain": [
            -1,
            1
          ],
          "range": [
            0.08,
            0.92
          ]
        }
      }
    },
    {
      "id": "hat-splat",
      "on": {
        "event": "onset",
        "tags": [
          "hat"
        ],
        "minConfidence": 0.4
      },
      "emit": {
        "intent": "splat",
        "zone": "air",
        "color": "@palette.air",
        "size": {
          "from": "strength",
          "range": [
            0.08,
            0.25
          ]
        },
        "weight": 0.1,
        "decaySec": 0.5,
        "spread": 1.0,
        "x": {
          "from": "pan",
          "domain": [
            -1,
            1
          ],
          "range": [
            0.08,
            0.92
          ]
        }
      }
    },
    {
      "id": "haze-fixed",
      "on": {
        "curve": "loudness"
      },
      "emit": {
        "intent": "haze",
        "zone": "all",
        "level": 0.45
      }
    },
    {
      "id": "lowend-front-led",
      "on": {
        "curve": [
          "band.sub",
          "band.bass"
        ]
      },
      "emit": {
        "intent": "footlight",
        "zone": "front",
        "normalize": "song"
      },
      "note": "前面LEDはサブ／ベースの大きい方で動く"
    },
    {
      "id": "guitar-side-beam",
      "on": {
        "event": "onset",
        "tags": [
          "guitar"
        ],
        "minConfidence": 0.4
      },
      "quantize": {
        "to": "none"
      },
      "limit": {
        "maxPerSec": 10
      },
      "emit": {
        "intent": "splat",
        "zone": "mid",
        "color": "#ff3fb4",
        "size": {
          "from": "strength",
          "range": [
            0.15,
            0.5
          ]
        },
        "weight": 0.25,
        "decaySec": 0.6,
        "spread": 0.4,
        "x": {
          "from": "position01",
          "range": [
            0,
            1
          ]
        }
      }
    }
  ]
}
